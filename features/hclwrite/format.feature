      | `\na = 1 # foo\nbungle = "bonce" # baz\nzebra = "striped" # baz\n` | `\na      = 1         # foo\nbungle = "bonce"   # baz\nzebra  = "striped" # baz\n` |
      | `\na = 1 # foo\nbungle = (\n    "bonce"\n) # baz\nzebra = "striped" # baz\n` | `\na = 1 # foo\nbungle = (\n  "bonce"\n)                 # baz\nzebra = "striped" # baz\n` |
